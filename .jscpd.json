{
  "threshold": 2.5,
  "reporters": ["html", "console", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/.venv/**",
    "**/coverage/**",
    "**/htmlcov/**",
    "**/*.lock",
    "**/package-lock.json",
    "**/__tests__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/test_*.py",
    "**/migrations/**",
    "**/docs/**"
  ],
  "format": ["typescript", "tsx", "javascript", "jsx", "python"],
  "absolute": true,
  "gitignore": true,
  "minTokens": 60,
  "minLines": 10
}
